{
  "name": "allos-technical-test",
  "version": "1.0.0",
  "private": true,
  "description": "NF-e intake and enrichment pipeline",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "test": "jest --runInBand",
    "migration:run": "typeorm -d dist/database/data-source.js migration:run",
    "migration:revert": "typeorm -d dist/database/data-source.js migration:revert",
    "migration:show": "typeorm -d dist/database/data-source.js migration:show",
    "migration:create": "typeorm migration:create",
    "test:cov": "jest --runInBand --coverage"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "roots": [
      "<rootDir>/src",
      "<rootDir>/test"
    ],
    "testMatch": [
      "**/*.spec.ts"
    ],
    "setupFiles": [
      "<rootDir>/test/support/env.ts"
    ],
    "verbose": true,
    "collectCoverageFrom": [
      "src/**/*.ts",
      "!src/main.ts",
      "!src/**/*.spec.ts",
      "!src/database/data-source.ts"
    ]
  },
  "dependencies": {
    "@nestjs/common": "^11.2.8",
    "@nestjs/core": "^11.2.8",
    "@nestjs/platform-express": "^11.2.8",
    "@nestjs/typeorm": "^11.0.3",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "pg": "^8.23.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "typeorm": "^0.3.31"
  },
  "devDependencies": {
    "@nestjs/testing": "^11.2.8",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/node": "^22.20.5",
    "@types/supertest": "^7.2.1",
    "jest": "^30.5.2",
    "supertest": "^7.3.1",
    "ts-jest": "^29.4.15",
    "typescript": "^5.9.3"
  },
  "overrides": {
    "multer": "^2.5.0"
  }
}
