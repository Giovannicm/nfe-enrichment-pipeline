# Copy to .env and fill in POSTGRES_PASSWORD and WEBHOOK_TOKEN. Never commit the .env file.
POSTGRES_USER=nfes
POSTGRES_PASSWORD=
POSTGRES_DB=nfes
WEBHOOK_TOKEN=

# Optional. Interval, in milliseconds, between outbox relay cycles (default 5000).
OUTBOX_RELAY_INTERVAL_MS=5000

# Optional. Interval, in milliseconds, between queue worker cycles (default 1000).
POLL_INTERVAL_MS=1000
# Optional. Wait, in milliseconds, before a failed queue message is delivered again (default 5000).
QUEUE_REDELIVERY_DELAY_MS=5000
# Optional. Deliveries before a failing queue message goes DEAD (default 5).
QUEUE_MAX_ATTEMPTS=5
